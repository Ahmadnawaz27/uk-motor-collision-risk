{
  "name": "Portfolio Risk Review",
  "dataColors": [
    "#1D4E89",
    "#3C8DBC",
    "#2FA39B",
    "#E8A33D",
    "#D4604A",
    "#7C5B9B",
    "#E07A3F",
    "#152A47",
    "#8FB4D9",
    "#9FD4CF",
    "#F2C987",
    "#E6A194"
  ],
  "foreground": "#152A47",
  "foregroundNeutralSecondary": "#5B6B84",
  "foregroundNeutralTertiary": "#8C99AD",
  "background": "#FFFFFF",
  "backgroundLight": "#F2F5F9",
  "backgroundNeutral": "#DEE5EE",
  "tableAccent": "#1D4E89",
  "good": "#2FA39B",
  "neutral": "#E8A33D",
  "bad": "#D4604A",
  "maximum": "#1D4E89",
  "center": "#8FB4D9",
  "minimum": "#EAF0F7",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 26,
      "color": "#152A47"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#152A47"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10,
      "color": "#152A47"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#5B6B84"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E3E8EF" } },
            "radius": 4
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#152A47" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "alignment": "left",
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "subTitle": [
          {
            "show": false,
            "fontColor": { "solid": { "color": "#5B6B84" } },
            "alignment": "left",
            "fontSize": 8,
            "fontFamily": "Segoe UI"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "labelColor": { "solid": { "color": "#5B6B84" } },
            "fontSize": 9,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "labelColor": { "solid": { "color": "#5B6B84" } },
            "fontSize": 9,
            "gridlineShow": true,
            "gridlineColor": { "solid": { "color": "#EDF1F6" } },
            "gridlineThickness": 1
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopLeft",
            "showTitle": false,
            "labelColor": { "solid": { "color": "#5B6B84" } },
            "fontSize": 9
          }
        ],
        "labels": [
          {
            "show": false,
            "color": { "solid": { "color": "#152A47" } },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#F2F5F9" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#152A47" } },
            "fontSize": 26,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#5B6B84" } },
            "fontSize": 8,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } }
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "text": [
          {
            "fontColor": { "solid": { "color": "#5B6B84" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "outline": [
          {
            "show": true,
            "lineColor": { "solid": { "color": "#C2CEDD" } },
            "weight": 1
          }
        ],
        "fill": [
          {
            "show": true,
            "fillColor": { "solid": { "color": "#FFFFFF" } }
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    }
  }
}
